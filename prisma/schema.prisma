generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Test {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  intro     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
  results   Result[]
}

model Question {
  id        String   @id @default(cuid())
  testId    String
  order     Int
  title     String
  axis      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  test    Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  options Option[]

  @@unique([testId, order])
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  label      String
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Result {
  id          String   @id @default(cuid())
  testId      String
  mbtiType    String
  mbtiTitle   String
  answersJson String
  aiAnalysis  String?
  createdAt   DateTime @default(now())

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)
}
